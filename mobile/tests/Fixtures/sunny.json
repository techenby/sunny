    "recipes": [
        {
            "id": 1,
            "parent_id": null,
            "name": "Buttermilk Pancakes",
            "source": "https:\/\/www.allrecipes.com\/recipe\/buttermilk-pancakes\/",
            "servings": "4",
            "prep_time": "10 minutes",
            "cook_time": "15 minutes",
            "total_time": "25 minutes",
            "description": "Fluffy weekend pancakes that come together in one bowl.",
            "ingredients": [
                {
                    "type": "item",
                    "text": "2 cups flour"
                },
                {
                    "type": "item",
                    "text": "2 cups buttermilk"
                },
                {
                    "type": "item",
                    "text": "2 eggs"
                },
                {
                    "type": "item",
                    "text": "3 tbsp melted butter"
                },
                {
                    "type": "item",
                    "text": "2 tbsp sugar"
                },
                {
                    "type": "item",
                    "text": "2 tsp baking powder"
                }
            ],
            "instructions": [
                {
                    "type": "step",
                    "text": "Whisk the dry ingredients together in a large bowl."
                },
                {
                    "type": "step",
                    "text": "Stir in the buttermilk, eggs, and melted butter until just combined."
                },
                {
                    "type": "step",
                    "text": "Cook ¼ cup of batter at a time on a hot griddle until bubbles form, then flip."
                }
            ],
            "notes": "Let the batter rest for five minutes for taller pancakes.",
            "nutrition": null,
            "tags": [
                "breakfast",
                "weekend"
            ],
            "created_at": "2026-06-02 09:15:00",
            "updated_at": "2026-09-21 08:30:00"
        },
        {
            "id": 2,
            "parent_id": null,
            "name": "Weeknight Chili",
            "source": "https:\/\/www.budgetbytes.com\/weeknight-chili\/",
            "servings": "6",
            "prep_time": "15 minutes",
            "cook_time": "30 minutes",
            "total_time": "45 minutes",
            "description": "A hearty, freezer-friendly chili.",
            "ingredients": [
                {
                    "type": "item",
                    "text": "1 lb ground beef"
                },
                {
                    "type": "item",
                    "text": "1 onion, diced"
                },
                {
                    "type": "item",
                    "text": "2 cans kidney beans"
                },
                {
                    "type": "item",
                    "text": "1 can crushed tomatoes"
                },
                {
                    "type": "item",
                    "text": "2 tbsp chili powder"
                },
                {
                    "type": "item",
                    "text": "1 tsp cumin"
                }
            ],
            "instructions": [
                {
                    "type": "step",
                    "text": "Brown the beef with the onion."
                },
                {
                    "type": "step",
                    "text": "Add the spices and cook for one minute."
                },
                {
                    "type": "step",
                    "text": "Stir in the beans and tomatoes, then simmer for 25 minutes."
                }
            ],
            "notes": null,
            "nutrition": "Calories: 410\nProtein: 28 g",
            "tags": [
                "dinner",
                "freezer-friendly"
            ],
            "created_at": "2026-07-11 18:05:00",
            "updated_at": "2026-07-11 18:05:00"
        },
        {
            "id": 3,
            "parent_id": null,
            "name": "Grandma’s Lasagna",
            "source": "Grandma’s recipe card",
            "servings": "8",
            "prep_time": "30 minutes",
            "cook_time": "1 hour",
            "total_time": "1 hour 30 minutes",
            "description": "The family favorite for birthdays and holidays.",
            "ingredients": [
                {
                    "type": "item",
                    "text": "12 lasagna noodles"
                },
                {
                    "type": "item",
                    "text": "1 lb Italian sausage"
                },
                {
                    "type": "item",
                    "text": "3 cups marinara"
                },
                {
                    "type": "item",
                    "text": "15 oz ricotta"
                },
                {
                    "type": "item",
                    "text": "3 cups mozzarella"
                },
                {
                    "type": "item",
                    "text": "1 egg"
                }
            ],
            "instructions": [
                {
                    "type": "step",
                    "text": "Brown the sausage and stir in the marinara."
                },
                {
                    "type": "step",
                    "text": "Mix the ricotta with the egg."
                },
                {
                    "type": "step",
                    "text": "Layer noodles, ricotta, sauce, and mozzarella three times."
                },
                {
                    "type": "step",
                    "text": "Cover and bake at 375°F for 45 minutes, then uncover for 15 more."
                }
            ],
            "notes": "Freezes well before baking.",
            "nutrition": null,
            "tags": [
                "dinner",
                "family favorite"
            ],
            "created_at": "2026-05-19 17:40:00",
            "updated_at": "2026-08-30 19:10:00"
        },
        {
            "id": 4,
            "parent_id": 3,
            "name": "Veggie Lasagna",
            "source": "Grandma’s recipe card",
            "servings": "8",
            "prep_time": "30 minutes",
            "cook_time": "1 hour",
            "total_time": "1 hour 30 minutes",
            "description": "Grandma’s lasagna with roasted vegetables instead of sausage.",
            "ingredients": [
                {
                    "type": "item",
                    "text": "12 lasagna noodles"
                },
                {
                    "type": "item",
                    "text": "2 zucchini, sliced"
                },
                {
                    "type": "item",
                    "text": "1 eggplant, sliced"
                },
                {
                    "type": "item",
                    "text": "3 cups marinara"
                },
                {
                    "type": "item",
                    "text": "15 oz ricotta"
                },
                {
                    "type": "item",
                    "text": "3 cups mozzarella"
                }
            ],
            "instructions": [
                {
                    "type": "step",
                    "text": "Roast the zucchini and eggplant at 425°F for 20 minutes."
                },
                {
                    "type": "step",
                    "text": "Layer noodles, ricotta, vegetables, sauce, and mozzarella three times."
                },
                {
                    "type": "step",
                    "text": "Cover and bake at 375°F for 45 minutes, then uncover for 15 more."
                }
            ],
            "notes": null,
            "nutrition": null,
            "tags": [
                "dinner",
                "vegetarian"
            ],
            "created_at": "2026-08-04 12:20:00",
            "updated_at": "2026-08-04 12:20:00"
        },
