                    "type": "item",
                    "text": "1 cup rolled oats"
                },
                {
                    "type": "item",
                    "text": "1 cup milk"
                },
                {
                    "type": "item",
                    "text": "½ cup Greek yogurt"
                },
                {
                    "type": "item",
                    "text": "1 tbsp chia seeds"
                }
            ],
            "instructions": [
                {
                    "type": "step",
                    "text": "Stir everything together in a jar, cover, and refrigerate overnight."
                }
            ],
            "notes": null,
