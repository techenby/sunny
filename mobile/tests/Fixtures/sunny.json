        {
            "id": 6,
            "parent_id": null,
            "name": "Chocolate Chip Cookies",
            "source": "https:\/\/www.kingarthurbaking.com\/recipes\/chocolate-chip-cookies-recipe",
            "servings": "24 cookies",
            "prep_time": "15 minutes",
            "cook_time": "10 minutes",
            "total_time": "25 minutes",
            "description": "Crisp edges, chewy centers.",
            "ingredients": [
                {
                    "type": "item",
                    "text": "2¼ cups flour"
                },
                {
                    "type": "item",
                    "text": "1 cup butter"
                },
                {
                    "type": "item",
                    "text": "¾ cup brown sugar"
                },
                {
                    "type": "item",
                    "text": "¾ cup sugar"
                },
                {
                    "type": "item",
                    "text": "2 eggs"
                },
                {
                    "type": "item",
                    "text": "2 cups chocolate chips"
                }
            ],
            "instructions": [
                {
                    "type": "step",
                    "text": "Cream the butter and sugars, then beat in the eggs."
                },
                {
                    "type": "step",
                    "text": "Mix in the flour, then fold in the chocolate chips."
                },
                {
                    "type": "step",
                    "text": "Bake spoonfuls at 375°F for 10 minutes."
                }
            ],
            "notes": null,
            "nutrition": null,
            "tags": [
                "dessert"
            ],
            "created_at": "2026-04-27 15:45:00",
            "updated_at": "2026-06-14 16:00:00"
        }
