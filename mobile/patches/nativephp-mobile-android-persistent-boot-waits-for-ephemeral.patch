+
+// The boot gate only stops ephemeral from racing a persistent boot that has
+// already started. WorkManager can run an overdue task the moment the process
+// starts, so ephemeral can read NEVER_STARTED and take the cold path just
+// before persistent opens the gate — or still be running that cold-path
+// runtime when persistent arrives. Either way two php_embed_init() calls
+// overlap and tsrm startup SIGSEGVs. Persistent takes g_ephemeral_mutex until
+// the gate is open, and waits out any live cold-path runtime first.
+static void lock_ephemeral_for_persistent_boot(void) {
+    int logged = 0;
 
+    pthread_mutex_lock(&g_ephemeral_mutex);
+    while (ephemeral_initialized && ephemeral_cold_booted) {
+        if (!logged) {
+            LOGI("persistent_boot: waiting for cold-path ephemeral runtime to shut down");
+            logged = 1;
+        }
+        pthread_mutex_unlock(&g_ephemeral_mutex);
+        usleep(20000);
+        pthread_mutex_lock(&g_ephemeral_mutex);
+    }
+}
