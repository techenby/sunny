{
    "name": "sunny/item-scanner",
    "description": "Identifies the items in a photo with Apple's on-device Foundation Models.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Andy Swick",
            "email": "andy@techenby.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "nativephp/mobile": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Sunny\\ItemScanner\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sunny\\ItemScanner\\ItemScannerServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    }
}
