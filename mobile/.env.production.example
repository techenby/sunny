# Production values for App Store and Play Store builds.
#
# NativePHP bundles .env into the app and reads APP_ENV when it packages it:
# anything but "production" limits an iOS upload to internal TestFlight testers
# and an Android upload to non-production tracks.
#
# Bifrost builds the store releases. It writes APP_ENV from the build's arc
# (use production), takes the version from the build, and appends the
# project's environment variables, so set SUNNY_API_URL, APP_DEBUG and
# LOG_LEVEL there to the values below.
#
# To package locally instead, set your development .env aside, then:
#
#   cp .env.production.example .env
#   php artisan key:generate --force
#   php artisan native:package ios --upload-to-app-store
#
# Bump NATIVEPHP_APP_VERSION with `php artisan native:release patch|minor|major`.
# --upload-to-app-store sets NATIVEPHP_APP_VERSION_CODE from App Store Connect.

APP_NAME=SunnyHome
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Main application API URL, including /api (must be reachable from the device).
SUNNY_API_URL=https://sunnyhome.app/api

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# NativePHP Configuration
NATIVEPHP_APP_ID=com.techenby.sunnyhome
NATIVEPHP_DEEPLINK_SCHEME=sunnyhome
NATIVEPHP_APP_VERSION="1.0.3"
NATIVEPHP_APP_VERSION_CODE="1"
NATIVEPHP_DEEPLINK_HOST=sunnyhome.app
NATIVEPHP_DEEPLINK_PATHS=/i/
NATIVEPHP_DEVELOPMENT_TEAM=9R65F2QT3W
